{
  "name": "jeremy-bryant-portfolio",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "deadgoodreviews.com/portfolio*", "zone_name": "deadgoodreviews.com" },
    { "pattern": "www.deadgoodreviews.com/portfolio*", "zone_name": "deadgoodreviews.com" }
  ]
}
