        "marker": "DEMO_ONLY_TOKEN_EXPORT",
        "state": "active"
      },
      {
        "id": "local-token",
        "marker": "DEMO_ONLY_TOKEN_LOCAL",
        "state": "active"
      },
      {
        "id": "unused-token",
        "marker": "DEMO_ONLY_TOKEN_UNUSED",
        "state": "active"
      }
    ],
    "files": [
      {
        "id": "app-config",
        "kind": "config",
        "audience": "local",
        "lines": [
